{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!**/.claude", "!**/.superpowers", "!**/*.md"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "style": {
        // The code asserts `x[i]!` on purpose where the index is in range by construction;
        // a dead branch to satisfy the rule would only add noise.
        "noNonNullAssertion": "off"
      }
    }
  }
}
